  "components": {
    "schemas": {
      "BookingOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "checkout_id": {
            "type": "string",
            "title": "Checkout Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "total_price": {
            "type": "integer",
            "title": "Total Price"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "offer": {
            "additionalProperties": true,
            "type": "object",
            "title": "Offer"
          },
          "passengers": {
            "items": {
              "$ref": "#/components/schemas/PassengerOut"
            },
            "type": "array",
            "title": "Passengers"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "reference",
          "kind",
          "provider",
          "checkout_id",
          "status",
          "failure_reason",
          "total_price",
          "currency",
          "offer",
          "passengers",
          "created_at"
        ],
        "title": "BookingOut"
      },
      "ChatIn": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatIn"
      },
      "ChatOut": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "cards": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Cards",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "reply"
        ],
        "title": "ChatOut"
      },
      "CheckoutIn": {
        "properties": {
          "offer_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Offer Ids"
          }
        },
        "type": "object",
        "required": [
          "offer_ids"
        ],
        "title": "CheckoutIn"
      },
      "CheckoutOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "gateway": {
            "type": "string",
            "title": "Gateway"
          },
          "gateway_order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gateway Order Id"
          },
          "gateway_key_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gateway Key Id"
          },
          "offers": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Offers"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "amount",
          "currency",
          "gateway",
          "gateway_order_id",
          "offers"
        ],
        "title": "CheckoutOut"
      },
      "ConfirmIn": {
        "properties": {
          "payment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PaymentIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "passengers": {
            "items": {
              "$ref": "#/components/schemas/PassengerIn"
            },
            "type": "array",
            "maxItems": 9,
            "minItems": 1,
            "title": "Passengers"
          },
          "contact": {
            "$ref": "#/components/schemas/ContactIn"
          }
        },
        "type": "object",
        "required": [
          "passengers",
          "contact"
        ],
        "title": "ConfirmIn"
      },
      "ConfirmOut": {
        "properties": {
          "checkout_id": {
            "type": "string",
            "title": "Checkout Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "bookings": {
            "items": {
              "$ref": "#/components/schemas/BookingOut"
            },
            "type": "array",
            "title": "Bookings"
          }
        },
        "type": "object",
        "required": [
          "checkout_id",
          "status",
          "bookings"
        ],
        "title": "ConfirmOut"
      },
      "ContactIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "title": "Phone",
            "description": "E.164, e.g. +919876543210"
          }
        },
        "type": "object",
        "required": [
          "email",
          "phone"
        ],
        "title": "ContactIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HotelOffer": {
        "properties": {
          "offer_id": {
            "type": "string",
            "title": "Offer Id"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "price": {
            "type": "integer",
            "title": "Price"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
