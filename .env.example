# Copy to .env (never commit it). Read by docker compose and the API.
DB_PASSWORD=change-me
SECRET_KEY=generate-with-openssl-rand-hex-32

# --- suppliers: comma separated, any of demo,duffel,amadeus ---
PROVIDERS=duffel
# DEMO produces FAKE bookings. Production refuses it unless ALLOW_DEMO_IN_PROD=true.
DUFFEL_TOKEN=duffel_test_xxx
# Amadeus Self-Service was shut down on 2026-07-17. Only for Enterprise customers; set the host from your contract.
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_BASE_URL=
# AMADEUS_CURRENCY=INR

# --- chat agent (any OpenAI-compatible server) ---
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=llama3.1
WEB_BASE_URL=https://travel.example.com

# --- WhatsApp Cloud API (all four required to enable the channel) ---
# WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- payments: demo (no money moves) or razorpay (enable Manual Capture in the dashboard) ---
PAYMENT_GATEWAY=demo
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# Production refuses PAYMENT_GATEWAY=demo and PROVIDERS=demo unless ALLOW_DEMO_IN_PROD=true
